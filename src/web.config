<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <rewrite>
      <rules>

        <!-- Internally route old API to V2 API -->
        <rule name="ServicesAPIv6 to V2" stopProcessing="true">
          <match url="^ServicesAPIv6/(.*)" />
          <action type="Rewrite" url="https://v2.oneinsure.com/ServicesAPIv6/{R:1}" appendQueryString="true" />
        </rule>

        <rule name="1SBSSO to V2" stopProcessing="true">
          <match url="^1sbsso/(.*)" />
          <action type="Rewrite" url="https://v2.oneinsure.com/1sbsso/{R:1}" appendQueryString="true" />
        </rule>

        <rule name="quoteapi to V2" stopProcessing="true">
          <match url="^quoteapi/(.*)" />
          <action type="Rewrite" url="https://v2.oneinsure.com/quoteapi/{R:1}" appendQueryString="true" />
        </rule>

        <rule name="mapiv3cv2 to V2" stopProcessing="true">
          <match url="^mapiv3cv2/(.*)" />
          <action type="Rewrite" url="https://v2.oneinsure.com/mapiv3cv2/{R:1}" appendQueryString="true" />
        </rule>

        <!-- Prerendered routes live in folders (/health-insurance-plans/index.html).
             Serve them at the slash-less URL instead of redirecting to a trailing slash. -->
        <rule name="Prerendered folder without slash" stopProcessing="true">
          <match url="^(.+[^/])$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
          </conditions>
          <action type="Rewrite" url="{R:1}/index.html" />
        </rule>

        <!-- Client-side only routes (not prerendered): let Angular handle them. -->
        <rule name="Angular client routes" stopProcessing="true">
          <match url="^(my-account(/.*)?|service(/.*)?|assistance/talk-to-an-advisor)$" ignoreCase="true" />
          <action type="Rewrite" url="/index.csr.html" />
        </rule>

        <!-- The old catch-all "Angular Routes" rule (rewrite everything to /) is removed on purpose:
             it made every unknown URL return 200 (soft 404). Unknown URLs now get a real 404 below. -->

      </rules>
    </rewrite>

    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    </staticContent>

    <!-- Unknown URLs: real HTTP 404 with the Angular 404 page.
         existingResponse="Auto" so 404 bodies coming back from the V2 API proxy are not replaced. -->
    <httpErrors errorMode="Custom" existingResponse="Auto">
      <remove statusCode="404" />
      <error statusCode="404" path="/404/index.html" responseMode="ExecuteURL" />
    </httpErrors>

    <validation validateIntegratedModeConfiguration="false" />
  </system.webServer>

  <!-- index.html must not be cached for a year, or new deploys won't show. -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="index.csr.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
